@model IEnumerable<Sakany.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadOnly = ViewBag.UnreadOnly as bool? ?? false;
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-bell-fill me-2 text-primary"></i>Notifications</h2>
            <p class="text-muted mb-0">You have <span class="badge bg-danger" id="unreadBadge">@unreadCount</span> unread notification@(unreadCount != 1 ? "s" : "")</p>
        </div>
        <div class="btn-group">
            <a asp-action="Index" asp-route-unreadOnly="false" class="btn @(unreadOnly ? "btn-outline-primary" : "btn-primary")">
                <i class="bi bi-list me-1"></i>All
            </a>
            <a asp-action="Index" asp-route-unreadOnly="true" class="btn @(unreadOnly ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-envelope-open me-1"></i>Unread
            </a>
        </div>
    </div>

    @if (unreadCount > 0)
    {
        <div class="mb-3">
            <button type="button" class="btn btn-outline-success btn-sm" onclick="markAllAsRead()">
                <i class="bi bi-check-all me-1"></i>Mark All as Read
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bell-slash display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No notifications</h4>
            <p class="text-muted">@(unreadOnly ? "You have no unread notifications." : "Your notification center is empty.")</p>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var item in Model)
            {
                <div class="list-group-item list-group-item-action p-3 @(item.IsRead ? "bg-light" : "")" id="notif-@item.ID">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div class="flex-grow-1 me-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                @if (!item.IsRead)
                                {
                                    <span class="badge bg-primary rounded-pill" style="width: 8px; height: 8px; padding: 0;"></span>
                                }
                                <span class="badge @item.PriorityBadgeClass">@item.PriorityLabel</span>
                                <span class="badge bg-secondary">@item.NotificationType</span>
                            </div>
                            <h5 class="mb-1 @(item.IsRead ? "text-muted" : "")">@item.Title</h5>
                            <p class="mb-1 text-muted small">@item.Body</p>
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i>@item.TimeAgo
                            </small>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            @if (!string.IsNullOrEmpty(item.ActionUrl))
                            {
                                <a href="@item.ActionUrl" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>@(item.ActionText ?? "View")
                                </a>
                            }
                            @if (!item.IsRead)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="markAsRead('@item.ID')">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            }
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-info-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function markAsRead(id) {
            fetch('/Notifications/MarkAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    const el = document.getElementById(`notif-${id}`);
                    if (el) {
                        el.classList.add('bg-light');
                        el.querySelector('.badge.bg-primary.rounded-pill')?.remove();
                        const btn = el.querySelector('button.btn-outline-success');
                        if (btn) btn.remove();
                    }
                    updateUnreadBadge(data.unreadCount);
                }
            });
        }

        function markAllAsRead() {
            fetch('/Notifications/MarkAllAsRead', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
        }

        function updateUnreadBadge(count) {
            const badge = document.getElementById('unreadBadge');
            if (badge) {
                badge.textContent = count;
                if (count === 0) badge.classList.add('d-none');
            }
        }
    </script>
}