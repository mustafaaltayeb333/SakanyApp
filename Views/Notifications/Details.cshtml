@model Sakany.Models.Notification
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Notifications</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge @Model.PriorityBadgeClass me-2">@Model.PriorityLabel</span>
                        <span class="badge bg-secondary">@Model.NotificationType</span>
                    </div>
                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@Model.TimeAgo</small>
                </div>
                <div class="card-body p-4">
                    <h3 class="card-title mb-3">@Model.Title</h3>
                    <p class="card-text fs-5 text-muted">@Model.Body</p>

                    @if (!string.IsNullOrEmpty(Model.ActionUrl))
                    {
                        <div class="mt-4">
                            <a href="@Model.ActionUrl" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-up-right me-2"></i>@(Model.ActionText ?? "Take Action")
                            </a>
                        </div>
                    }

                    <hr class="my-4" />
                    <div class="row text-muted small">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Received:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                            @if (Model.ReadAt.HasValue)
                            {
                                <p class="mb-0"><strong>Read:</strong> @Model.ReadAt.Value.ToString("MMM dd, yyyy HH:mm")</p>
                            }
                            else
                            {
                                <p class="mb-0"><span class="badge bg-primary">Unread</span></p>
                            }
                        </div>
                        <div class="col-md-6 text-md-end">
                            <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="d-inline" onsubmit="return confirm('Delete this notification?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Notifications
                </a>
            </div>
        </div>
    </div>
</div>