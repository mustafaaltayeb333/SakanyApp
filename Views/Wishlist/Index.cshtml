@model IEnumerable<Sakany.Models.Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="display-6 fw-bold text-primary">My Wishlist</h2>
            <p class="text-muted">You have @Model.Count() saved properties.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="card-body">
                <i class="bi bi-heart-fill text-light mb-3" style="font-size: 4rem;"></i>
                <h3>Your wishlist is empty</h3>
                <p class="text-muted">Start exploring our properties to find your dream home!</p>
                <a asp-controller="Property" asp-action="Index" class="btn btn-primary px-4 mt-2">Explore Properties</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <div class="position-relative">
                            @{
                                var firstImage = item.Property.Image?.FirstOrDefault()?.ImageURL;
                            }
                            <img src="@(string.IsNullOrEmpty(firstImage) ? "/images/placeholder.jpg" : firstImage)"
                                 class="card-img-top" alt="Property" style="height: 220px; object-fit: cover;">

                            <span class="badge bg-success position-absolute top-0 start-0 m-3 px-3 py-2">
                                @item.Property.Type
                            </span>

                            <a asp-action="Remove" asp-route-propertyId="@item.PropertyID"
                               class="btn btn-danger btn-sm position-absolute top-0 end-0 m-3 rounded-circle"
                               title="Remove from Wishlist">
                                <i class="bi bi-heartbreak-fill"></i>
                            </a>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="text-primary fw-bold mb-0">EGP @item.Property.Price.ToString("N0")</h4>
                                <small class="text-muted"><i class="bi bi-calendar3"></i> @item.DateAdded.ToString("MMM dd")</small>
                            </div>

                            <h5 class="card-title text-truncate">@item.Property.City</h5>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill"></i> @item.Property.Address</p>

                            <div class="d-flex justify-content-between border-top pt-3 text-secondary small">
                                <span><i class="bi bi-door-open"></i> @item.Property.BedRooms Beds</span>
                                <span><i class="bi bi-droplet"></i> @item.Property.BathRooms Baths</span>
                                <span><i class="bi bi-fullscreen"></i> @item.Property.Area m²</span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid gap-2">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyID"
                                   class="btn btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>