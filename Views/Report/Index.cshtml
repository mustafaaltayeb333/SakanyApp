@model IEnumerable<Sakany.Models.Report>
@{
    ViewData["Title"] = "Reports";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-flag-fill me-2 text-danger"></i>Reports</h2>
            <p class="text-muted mb-0">@Model.Count() report@(Model.Count() != 1 ? "s" : "") found</p>
        </div>
        <a asp-action="Create" class="btn btn-danger">
            <i class="bi bi-plus-lg me-1"></i>Submit Report
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Reporter</th>
                        <th>Property</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Status switch
                        {
                            ReportStatus.Pending => "bg-warning text-dark",
                            ReportStatus.Reviewed => "bg-info",
                            ReportStatus.Dismissed => "bg-secondary",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td><code class="small">@item.ID[..8]</code></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:0.8rem;font-weight:700;">
                                        @(item.Reporter?.Name?[0].ToString().ToUpper() ?? "U")
                                    </div>
                                    <span class="small">@item.Reporter?.Name</span>
                                </div>
                            </td>
                            <td class="small">@item.Property?.Address</td>
                            <td class="small text-truncate" style="max-width: 200px;">@item.Reason</td>
                            <td><span class="badge @statusClass">@item.Status</span></td>
                            <td class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>