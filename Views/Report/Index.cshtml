@model IEnumerable<Sakany.Models.Report>

@{
    ViewData["Title"] = "Reports";
    var sessionRole = Context.Session.GetString("UserRole") ?? "";
    var isAdmin = sessionRole == "Admin";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1"><i class="bi bi-flag-fill me-2"></i>Reports</h3>
            <p class="text-muted mb-0">@(isAdmin ? "Review and manage incident reports" : "Track your submitted reports")</p>
        </div>
        <a asp-action="Create" class="btn btn-warning text-dark">
            <i class="bi bi-plus-lg me-1"></i>Submit Report
        </a>
    </div>

    <!-- Stats Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-warning">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-25 p-3 me-3">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 text-muted">Pending Review</h6>
                        <h4 class="mb-0">@Model.Count(r => r.Status == ReportStatus.Pending)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-25 p-3 me-3">
                        <i class="bi bi-check-circle text-info fs-4"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 text-muted">Reviewed</h6>
                        <h4 class="mb-0">@Model.Count(r => r.Status == ReportStatus.Reviewed)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-secondary bg-opacity-25 p-3 me-3">
                        <i class="bi bi-x-circle text-secondary fs-4"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 text-muted">Dismissed</h6>
                        <h4 class="mb-0">@Model.Count(r => r.Status == ReportStatus.Dismissed)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Property</th>
                        <th>Reason</th>
                        @if (isAdmin)
                        {
                            <th>Reporter</th>
                        }
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.PropertyID" class="fw-semibold text-decoration-none">
                                    @item.Property?.Address
                                </a>
                                <br />
                                <small class="text-muted">@item.Property?.City</small>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 250px;">@item.Reason</span>
                            </td>
                            @if (isAdmin)
                            {
                                <td>@item.Reporter?.Name</td>
                            }
                            <td>
                                <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case ReportStatus.Pending:
                                        <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                        break;
                                    case ReportStatus.Reviewed:
                                        <span class="badge rounded-pill bg-info px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>Reviewed
                                        </span>
                                        break;
                                    case ReportStatus.Dismissed:
                                        <span class="badge rounded-pill bg-secondary px-3 py-2">
                                            <i class="bi bi-x-circle me-1"></i>Dismissed
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-info" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-outline-primary" title="Update Status">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-clipboard-x display-1 text-muted"></i>
            <h5 class="mt-3 text-muted">No reports found</h5>
            <a asp-action="Create" class="btn btn-warning text-dark mt-2">Submit your first report</a>
        </div>
    }
</div>
