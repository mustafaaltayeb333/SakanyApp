@model Sakany.Models.Report

@{
    ViewData["Title"] = "Submit Report";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-flag-fill me-2"></i>Submit a Report</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <div>
                            Use this form to report maintenance issues, contract disputes, or other property-related incidents. Reports are reviewed by administrators.
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Property Selection -->
                        <div class="mb-3">
                            <label for="PropertyID" class="form-label fw-semibold">Select Property</label>
                            <select name="PropertyID" id="PropertyID" class="form-select" asp-for="PropertyID"
                                    asp-items="ViewBag.PropertyID">
                                <option value="">-- Select a property --</option>
                            </select>
                            <span asp-validation-for="PropertyID" class="text-danger"></span>
                            <small class="text-muted">Choose the property related to this report</small>
                        </div>

                        <!-- Reason / Description -->
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Reason" class="form-control" rows="6"
                                      placeholder="Describe the issue in detail. Include dates, specific locations within the property, and any other relevant information."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <!-- Status Preview (Read Only) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Report Status</label>
                            <div>
                                <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                </span>
                                <small class="text-muted ms-2">Status will be updated by an administrator after review</small>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Property" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Properties
                            </a>
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="bi bi-send-fill me-1"></i>Submit Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
