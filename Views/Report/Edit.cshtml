@model Sakany.Models.Report
@{
    ViewData["Title"] = "Edit Report";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ID">Details</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Report Status</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ID" />

                        <!-- Read-only Info -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Reporter</label>
                                <input type="text" class="form-control" value="@Model.Reporter?.Name" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted">Property</label>
                                <input type="text" class="form-control" value="@Model.Property?.Address, @Model.Property?.City" disabled />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted">Original Reason</label>
                            <textarea class="form-control" rows="3" disabled>@Model.Reason</textarea>
                        </div>

                        <hr class="my-4" />

                        <!-- Editable -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-semibold">Update Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ReportStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-light border mb-4">
                            <h6 class="alert-heading"><i class="bi bi-bell me-2"></i>Notification</h6>
                            <p class="mb-0 small text-muted">The reporter will be automatically notified when you save status changes.</p>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Details
                            </a>
                            <div class="d-flex gap-2">
                                <button type="reset" class="btn btn-outline-danger">
                                    <i class="bi bi-x-lg me-1"></i>Reset
                                </button>
                                <button type="submit" class="btn btn-warning px-4">
                                    <i class="bi bi-check-lg me-1"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}