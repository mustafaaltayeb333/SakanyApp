@inject Sakany.Data.SakanyDbContext _dbContext
@inject Sakany.Services.INotificationService _notificationService
@{
    int unreadNotificationCount = 0;
    List<Sakany.Models.Notification> recentNotifications = new();
    var currentUserId = Context.Session.GetString("UserID");
    var currentUserRole = Context.Session.GetString("UserRole");
    
    if (!string.IsNullOrEmpty(currentUserId))
    {
        unreadNotificationCount = await _dbContext.Notification
            .CountAsync(n => n.UserID == currentUserId && !n.IsRead);
        
        recentNotifications = await _dbContext.Notification
            .Where(n => n.UserID == currentUserId)
            .OrderByDescending(n => n.Priority)
            .ThenByDescending(n => n.CreatedAt)
            .Take(5)
            .ToListAsync();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sakany</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
	@await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --sakany-primary: #e74c3c;
            --sakany-dark: #1a1a2e;
            --sakany-accent: #f39c12;
            --sakany-light-bg: #f8f9fa;
            --sakany-card-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f8f9fa;
            color: #2d2d2d;
        }

        /* ── NAVBAR ── */
        .sakany-nav {
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1030;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        .sakany-nav .navbar-brand {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--sakany-primary) !important;
            letter-spacing: -0.5px;
        }

        .sakany-nav .navbar-brand span {
            color: var(--sakany-dark);
        }

        .sakany-nav .nav-link {
            color: #555 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 0.6rem 0.9rem !important;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .sakany-nav .nav-link:hover {
            color: var(--sakany-primary) !important;
            background: #fef2f2;
        }

        .sakany-nav .nav-link.active {
            color: var(--sakany-primary) !important;
            background: #fef2f2;
        }

        .btn-nav-login {
            border: 1.5px solid var(--sakany-primary);
            color: var(--sakany-primary) !important;
            border-radius: 20px;
            padding: 0.35rem 1.1rem !important;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s;
        }

        .btn-nav-login:hover {
            background: var(--sakany-primary);
            color: #fff !important;
        }

        .btn-nav-register {
            background: var(--sakany-primary);
            color: #fff !important;
            border-radius: 20px;
            padding: 0.35rem 1.1rem !important;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s;
        }

        .btn-nav-register:hover {
            background: #c0392b;
            color: #fff !important;
        }

        /* ── USER DROPDOWN ── */
        .user-avatar {
            width: 34px;
            height: 34px;
            background: var(--sakany-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
        }

        /* ── NAV ICON BUTTON ── */
        .nav-icon-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            color: #555;
            border-radius: 50%;
            text-decoration: none;
            transition: all 0.2s;
            font-size: 1.1rem;
        }

        .nav-icon-btn:hover {
            color: var(--sakany-primary);
            background: #fef2f2;
        }

        /* ── NAV BADGE ── */
        .nav-badge {
            position: absolute;
            top: 2px;
            right: 2px;
            min-width: 16px;
            height: 16px;
            padding: 0 4px;
            font-size: 0.65rem;
            font-weight: 700;
            line-height: 16px;
            border-radius: 8px;
            background: var(--sakany-primary);
            color: #fff;
            text-align: center;
            display: none;
        }

        .nav-badge.show {
            display: block;
        }

        /* ── NOTIFICATION DROPDOWN ── */
        .notification-dropdown {
            width: 360px;
            max-height: 480px;
            overflow-y: auto;
            padding: 0;
        }

        .notification-item {
            padding: 0.875rem 1rem;
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.15s;
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .notification-item:hover {
            background: #f8f9fa;
        }

        .notification-item.unread {
            background: #fff8f8;
            border-left: 3px solid var(--sakany-primary);
        }

        .notification-item.unread:hover {
            background: #fef2f2;
        }

        .notification-item .notif-title {
            font-weight: 600;
            font-size: 0.875rem;
            margin-bottom: 0.25rem;
            color: #1a1a2e;
        }

        .notification-item.unread .notif-title {
            color: var(--sakany-primary);
        }

        .notification-item .notif-body {
            font-size: 0.8rem;
            color: #6c757d;
            margin-bottom: 0.25rem;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .notification-item .notif-meta {
            font-size: 0.75rem;
            color: #adb5bd;
        }

        .notification-item .notif-priority {
            font-size: 0.65rem;
            padding: 0.15em 0.5em;
            border-radius: 10px;
            font-weight: 600;
        }

        .priority-urgent { background: #f8d7da; color: #721c24; }
        .priority-high { background: #fff3cd; color: #856404; }
        .priority-normal { background: #d1ecf1; color: #0c5460; }
        .priority-low { background: #e2e3e5; color: #383d41; }

        .notification-dropdown .dropdown-header {
            padding: 0.875rem 1rem;
            font-weight: 600;
            color: #1a1a2e;
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
            border-bottom: 1px solid #e9ecef;
        }

        .notification-dropdown .dropdown-footer {
            padding: 0.75rem 1rem;
            text-align: center;
            position: sticky;
            bottom: 0;
            background: #fff;
            border-top: 1px solid #e9ecef;
        }

        .notification-dropdown .empty-state {
            padding: 2.5rem 1rem;
            text-align: center;
            color: #adb5bd;
        }

        /* ── ALERTS ── */
        .global-alert {
            border-radius: 0;
            border: none;
            border-left: 4px solid;
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            min-height: calc(100vh - 140px);
        }

        /* ── FOOTER ── */
        .sakany-footer {
            background: var(--sakany-dark);
            color: #adb5bd;
            padding: 2.5rem 0 1.2rem;
            margin-top: 3rem;
        }

        .sakany-footer .footer-brand {
            font-size: 1.4rem;
            font-weight: 800;
            color: #fff;
        }

        .sakany-footer .footer-brand span {
            color: var(--sakany-primary);
        }

        .sakany-footer a {
            color: #adb5bd;
            text-decoration: none;
            font-size: 0.88rem;
            transition: color 0.2s;
        }

        .sakany-footer a:hover {
            color: var(--sakany-primary);
        }

        .sakany-footer .footer-heading {
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 1rem;
        }

        .sakany-footer .footer-bottom {
            border-top: 1px solid #2d3748;
            padding-top: 1rem;
            margin-top: 1.5rem;
            font-size: 0.82rem;
        }

        /* ── CARDS ── */
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: var(--sakany-card-shadow);
        }

        /* ── BUTTONS ── */
        .btn-primary {
            background: var(--sakany-primary);
            border-color: var(--sakany-primary);
        }
        .btn-primary:hover {
            background: #c0392b;
            border-color: #c0392b;
        }

        /* ── BADGES ── */
        .badge-available { background: #d4edda; color: #155724; }
        .badge-rented { background: #fff3cd; color: #856404; }
        .badge-sold { background: #f8d7da; color: #721c24; }
		.sort-btn.active { background: var(--sakany-primary) !important; color: white !important; border-color: var(--sakany-primary) !important; }
		.sort-btn.active .sort-icon { display: inline-block !important; }
		.sort-btn .sort-icon { display: none; }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg sakany-nav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Sak<span>any</span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain" aria-controls="navbarMain"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Left links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Property" ? "active" : "")" asp-controller="Property" asp-action="Index">
                            <i class="bi bi-buildings me-1"></i>Properties
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Requests" ? "active" : "")" asp-controller="Requests" asp-action="Index">
                            <i class="bi bi-file-text me-1"></i>Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reviews" ? "active" : "")" asp-controller="Reviews" asp-action="Index">
                            <i class="bi bi-star me-1"></i>Reviews
                        </a>
                    </li>

                    @if (currentUserRole == "Admin")
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(new[]{"Dashboard","User","Report","Notifications","Contract","Amenity","Messages"}.Contains(ViewContext.RouteData.Values["Controller"]?.ToString()) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-speedometer2 me-1"></i>Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Index"><i class="bi bi-people me-2"></i>Users</a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Index"><i class="bi bi-flag me-2"></i>Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                                <li><a class="dropdown-item" asp-controller="Contract" asp-action="Index"><i class="bi bi-file-earmark-text me-2"></i>Contracts</a></li>
                                <li><a class="dropdown-item" asp-controller="Amenity" asp-action="Index"><i class="bi bi-grid-3x3-gap me-2"></i>Amenities</a></li>
                                <li><a class="dropdown-item" asp-controller="Messages" asp-action="Inbox"><i class="bi bi-chat me-2"></i>Messages</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <!-- Right side -->
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(currentUserId))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Wishlist" ? "active" : "")" asp-controller="Wishlist" asp-action="Index">
                                <i class="bi bi-heart me-1"></i>Wishlist
                            </a>
                        </li>

                        <!-- MESSAGES with badge -->
                        <li class="nav-item">
                            <a class="nav-icon-btn" asp-controller="Messages" asp-action="Inbox" title="Messages" id="msgLink">
                                <i class="bi bi-chat-dots"></i>
                                <span class="nav-badge" id="msgBadge"></span>
                            </a>
                        </li>

                        <!-- NOTIFICATIONS DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-icon-btn dropdown-toggle no-caret" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" id="notifDropdownToggle">
                                <i class="bi bi-bell"></i>
                                <span class="nav-badge @(unreadNotificationCount > 0 ? "show" : "")" id="notifBadge">@(unreadNotificationCount > 0 ? unreadNotificationCount.ToString() : "")</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end notification-dropdown shadow-lg" aria-labelledby="notifDropdownToggle">
                                <div class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-bell-fill me-2 text-primary"></i>Notifications</span>
                                    @if (unreadNotificationCount > 0)
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none p-0" onclick="markAllNotificationsRead(event)">
                                            <small>Mark all read</small>
                                        </button>
                                    }
                                </div>
                                <div id="notificationListContainer">
                                    @if (!recentNotifications.Any())
                                    {
                                        <div class="empty-state">
                                            <i class="bi bi-bell-slash display-6 d-block mb-2"></i>
                                            <p class="mb-0 small">No notifications yet</p>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var notif in recentNotifications)
                                        {
                                            <a class="notification-item @(notif.IsRead ? "" : "unread")" href="@(notif.ActionUrl ?? $"/Notifications/Details/{notif.ID}")" onclick="markNotificationRead('@notif.ID', event)">
                                                <div class="d-flex justify-content-between align-items-start mb-1">
                                                    <span class="notif-title">@notif.Title</span>
                                                    <span class="notif-priority priority-@(notif.Priority == 3 ? "urgent" : notif.Priority == 2 ? "high" : notif.Priority == 1 ? "normal" : "low")">
                                                        @(notif.Priority == 3 ? "!" : notif.Priority == 2 ? "!!" : "")
                                                    </span>
                                                </div>
                                                <p class="notif-body mb-1">@notif.Body</p>
                                                <div class="notif-meta d-flex justify-content-between">
                                                    <span><i class="bi bi-clock me-1"></i>@notif.TimeAgo</span>
                                                    <span class="badge bg-secondary" style="font-size: 0.65rem;">@notif.NotificationType</span>
                                                </div>
                                            </a>
                                        }
                                    }
                                </div>
                                <div class="dropdown-footer">
                                    <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="bi bi-list me-1"></i>View All Notifications
                                    </a>
                                </div>
                            </div>
                        </li>

                        <!-- USER DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                               href="#" role="button" data-bs-toggle="dropdown">
                                <div class="user-avatar">
                                    @(Context.Session.GetString("UserName")?[0].ToString().ToUpper() ?? "U")
                                </div>
                                <span class="d-none d-lg-inline">@Context.Session.GetString("UserName")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header text-muted small">
                                    @Context.Session.GetString("UserEmail")
                                    <span class="badge bg-secondary ms-1">@currentUserRole</span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>My Wishlist</a></li>
                                @if (currentUserRole == "Admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn-nav-login" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-register" asp-controller="Account" asp-action="Register">Sign Up</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- GLOBAL ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success global-alert border-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger global-alert border-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info global-alert border-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- MAIN CONTENT -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="sakany-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-2">Sak<span>any</span></div>
                    <p class="small mb-3">Find your perfect home. Browse thousands of verified properties across Egypt.</p>
                    <div class="d-flex gap-3">
                        <a href="#"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#"><i class="bi bi-twitter-x fs-5"></i></a>
                        <a href="#"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#"><i class="bi bi-linkedin fs-5"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <div class="footer-heading">Explore</div>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Property" asp-action="Index">All Properties</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Reviews" asp-action="Index">Reviews</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-3 col-6">
                    <div class="footer-heading">Account</div>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register">Register</a></li>
                        <li class="mb-2"><a asp-controller="Account" asp-action="Profile">Profile</a></li>
                        <li class="mb-2"><a asp-controller="Wishlist" asp-action="Index">My Wishlist</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="footer-heading">Contact</div>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2"></i>Cairo, Egypt</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2"></i>support@sakany.eg</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2"></i>+20 100 000 0000</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <span>&copy; 2026 Sakany. All rights reserved.</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- NOTIFICATION SCRIPTS -->
    <script>
        // Mark single notification as read
        async function markNotificationRead(id, event) {
            // Don't prevent default - let the link navigate
            // But fire the AJAX request in background
            fetch('/Notifications/MarkAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: `id=${encodeURIComponent(id)}`
            }).then(() => refreshNotificationBadge());
        }

        // Mark all notifications as read
        async function markAllNotificationsRead(event) {
            event.preventDefault();
            event.stopPropagation();
            
            fetch('/Notifications/MarkAllAsRead', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    // Remove unread styling from all items
                    document.querySelectorAll('.notification-item.unread').forEach(el => {
                        el.classList.remove('unread');
                    });
                    refreshNotificationBadge();
                }
            });
        }

        // Refresh notification badge count
        function refreshNotificationBadge() {
            fetch('/Notifications/GetUnreadCount')
                .then(r => r.json())
                .then(data => {
                    const badge = document.getElementById('notifBadge');
                    if (data.count > 0) {
                        badge.textContent = data.count > 99 ? '99+' : data.count;
                        badge.classList.add('show');
                    } else {
                        badge.textContent = '';
                        badge.classList.remove('show');
                    }
                });
        }

        // Poll for new notifications every 30 seconds
        setInterval(refreshNotificationBadge, 30000);

        // Prevent dropdown toggle from closing when clicking inside
        document.querySelector('.notification-dropdown')?.addEventListener('click', function(e) {
            if (e.target.closest('a') || e.target.closest('button')) {
                // Allow normal behavior for links and buttons
                return;
            }
            e.stopPropagation();
        });

        // Message badge polling (placeholder for future message service)
        function refreshMessageBadge() {
            // TODO: Implement when messaging service is built
            // fetch('/Messages/GetUnreadCount').then(...)
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>