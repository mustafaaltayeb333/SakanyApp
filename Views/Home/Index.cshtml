@model IEnumerable<Sakany.Models.Property>
@{
    ViewData["Title"] = "Home";
    var cities = ViewBag.Cities as List<string> ?? new List<string>();
}

<!-- ═══════════════════════════════════════════
     HERO SECTION
══════════════════════════════════════════════ -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="hero-title">Find Your Perfect Home</h1>
                <p class="hero-subtitle">Discover thousands of verified apartments, studios and villas across Egypt.</p>

                <!-- SEARCH BAR -->
                <div class="search-card">
                    <form asp-controller="Home" asp-action="Index" method="get">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <div class="search-field">
                                    <i class="bi bi-geo-alt"></i>
                                    <select name="city" class="form-select search-select">
                                        <option value="">All Cities</option>
                                        @foreach (var city in cities)
                                        {
                                            <option value="@city" selected="@(ViewBag.SelectedCity == city ? "selected" : null)">@city</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="search-field">
                                    <i class="bi bi-house"></i>
                                    <select name="type" class="form-select search-select">
                                        <option value="">Any Type</option>
                                        <option value="Apartment" selected="@(ViewBag.SelectedType == "Apartment" ? "selected" : null)">Apartment</option>
                                        <option value="Studio" selected="@(ViewBag.SelectedType == "Studio" ? "selected" : null)">Studio</option>
                                        <option value="Villa" selected="@(ViewBag.SelectedType == "Villa" ? "selected" : null)">Villa</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-search w-100">
                                    <i class="bi bi-search me-2"></i>Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     STATS STRIP
══════════════════════════════════════════════ -->
<section class="stats-strip">
    <div class="container">
        <div class="row text-center g-0">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">@ViewBag.PropertiesCount+</div>
                    <div class="stat-label"><i class="bi bi-buildings me-1"></i>Properties</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">@ViewBag.UsersCount+</div>
                    <div class="stat-label"><i class="bi bi-people me-1"></i>Happy Users</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">@ViewBag.RequestsCount+</div>
                    <div class="stat-label"><i class="bi bi-file-text me-1"></i>Requests</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-number">@ViewBag.ReviewsCount+</div>
                    <div class="stat-label"><i class="bi bi-star me-1"></i>Reviews</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     FEATURED PROPERTIES
══════════════════════════════════════════════ -->
<section class="properties-section py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="section-title">Latest Available Properties</h2>
                <p class="section-subtitle">Fresh listings just posted</p>
            </div>
            <a asp-controller="Property" asp-action="Index" class="btn btn-outline-primary btn-sm px-4">
                View All <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-buildings display-1 text-muted opacity-25"></i>
                <p class="mt-3 text-muted">No available properties at the moment.</p>
                <a asp-controller="Property" asp-action="Create" class="btn btn-primary">List a Property</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-md-6">
                        <div class="property-card">
                            <!-- IMAGE -->
                            <div class="property-img-wrap">
                                @{
                                    var firstImage = item.Image?.FirstOrDefault();
                                }
                                @if (firstImage != null)
                                {
                                    <img src="@firstImage.ImageURL" class="property-img" alt="Property Image" />
                                }
                                else
                                {
                                    <div class="property-img-placeholder">
                                        <i class="bi bi-buildings"></i>
                                    </div>
                                }
                                <!-- TYPE BADGE -->
                                <span class="property-type-badge">@item.Type</span>
                                <!-- WISHLIST BUTTON -->
                                <a asp-controller="Wishlist" asp-action="Add" asp-route-propertyId="@item.ID"
                                   class="wishlist-btn" title="Add to wishlist">
                                    <i class="bi bi-heart"></i>
                                </a>
                            </div>

                            <!-- BODY -->
                            <div class="property-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="property-price">EGP @item.Price.ToString("N0") <span class="per-month">/mo</span></h5>
                                    <span class="property-status-dot @(item.Status == Sakany.Models.PropertyStatus.Available ? "dot-green" : "dot-yellow")"></span>
                                </div>
                                <p class="property-address">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@item.Address
                                </p>
                                <p class="property-city text-muted small mb-3">
                                    <i class="bi bi-map me-1"></i>@item.City
                                </p>

                                <!-- SPECS ROW -->
                                <div class="property-specs">
                                    <span><i class="bi bi-door-open"></i> @item.BedRooms bd</span>
                                    <span><i class="bi bi-droplet"></i> @item.BathRooms ba</span>
                                    <span><i class="bi bi-arrows-fullscreen"></i> @item.Area m²</span>
                                    <span><i class="bi bi-person-check"></i> @item.AvailableRooms avail</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="property-owner">
                                        <div class="owner-avatar">@(item.Owner?.Name?[0].ToString() ?? "?")</div>
                                        <small class="text-muted">@item.Owner?.Name</small>
                                    </div>
                                    <a asp-controller="Property" asp-action="Details" asp-route-id="@item.ID"
                                       class="btn btn-sm btn-details">
                                        Details <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════
     FEATURES / WHY SAKANY
══════════════════════════════════════════════ -->
<section class="features-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Why Choose Sakany?</h2>
            <p class="section-subtitle">Your trusted real estate platform in Egypt</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon"><i class="bi bi-shield-check"></i></div>
                    <h5>Verified Listings</h5>
                    <p class="text-muted small">All properties are verified by our team before being listed.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon"><i class="bi bi-lightning-charge"></i></div>
                    <h5>Instant Requests</h5>
                    <p class="text-muted small">Submit rental requests in seconds and get fast responses.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card text-center">
                    <div class="feature-icon"><i class="bi bi-chat-dots"></i></div>
                    <h5>Direct Messaging</h5>
                    <p class="text-muted small">Chat directly with owners for any questions or negotiations.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     CTA SECTION
══════════════════════════════════════════════ -->
@if (Context.Session.GetString("UserID") == null)
{
    <section class="cta-section py-5">
        <div class="container">
            <div class="cta-card text-center">
                <h2 class="mb-3">Ready to find your home?</h2>
                <p class="text-muted mb-4">Join thousands of happy tenants who found their perfect place on Sakany.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">Get Started Free</a>
                    <a asp-controller="Property" asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">Browse Properties</a>
                </div>
            </div>
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════
     STYLES (scoped to home)
══════════════════════════════════════════════ -->
<style>
    /* HERO */
    .hero-section {
        position: relative;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 480px;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400"><circle cx="600" cy="100" r="200" fill="%23e74c3c" opacity="0.06"/><circle cx="100" cy="350" r="150" fill="%23f39c12" opacity="0.05"/></svg>') no-repeat center;
        background-size: cover;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 4rem 1rem;
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.75);
        margin-bottom: 2rem;
    }

    /* SEARCH CARD */
    .search-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    }

    .search-field {
        position: relative;
    }

    .search-field i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
        z-index: 5;
        font-size: 1rem;
    }

    .search-select {
        padding-left: 2.2rem;
        border-radius: 10px;
        border: 1.5px solid #e9ecef;
        height: 46px;
        font-size: 0.9rem;
    }

    .search-select:focus {
        border-color: var(--sakany-primary);
        box-shadow: 0 0 0 0.2rem rgba(231,76,60,0.15);
    }

    .btn-search {
        background: var(--sakany-primary);
        color: #fff;
        border: none;
        border-radius: 10px;
        height: 46px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

    .btn-search:hover {
        background: #c0392b;
        color: #fff;
        transform: translateY(-1px);
    }

    /* STATS STRIP */
    .stats-strip {
        background: #fff;
        border-bottom: 1px solid #e9ecef;
        padding: 1.5rem 0;
    }

    .stat-item {
        padding: 0.5rem 1rem;
        border-right: 1px solid #f0f0f0;
    }
    .stat-item:last-child { border-right: none; }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--sakany-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8rem;
        color: #888;
        margin-top: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* SECTION TYPOGRAPHY */
    .section-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .section-subtitle {
        color: #888;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    /* PROPERTY CARD */
    .property-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.07);
        transition: all 0.3s ease;
        height: 100%;
    }

    .property-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.14);
    }

    .property-img-wrap {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: #eee;
    }

    .property-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .property-card:hover .property-img {
        transform: scale(1.05);
    }

    .property-img-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #ccc;
    }

    .property-type-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(255,255,255,0.95);
        color: var(--sakany-primary);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.7rem;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .wishlist-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(255,255,255,0.9);
        border: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        text-decoration: none;
        font-size: 1rem;
        transition: all 0.2s;
    }

    .wishlist-btn:hover {
        background: #fff;
        color: var(--sakany-primary);
        transform: scale(1.1);
    }

    .property-body {
        padding: 1.1rem 1.2rem;
    }

    .property-price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0;
    }

    .per-month {
        font-size: 0.75rem;
        font-weight: 400;
        color: #888;
    }

    .property-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-top: 6px;
    }

    .dot-green { background: #28a745; box-shadow: 0 0 0 3px rgba(40,167,69,0.2); }
    .dot-yellow { background: #ffc107; box-shadow: 0 0 0 3px rgba(255,193,7,0.2); }

    .property-address {
        font-size: 0.88rem;
        color: #444;
        margin-bottom: 0.2rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .property-specs {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
    }

    .property-specs span {
        font-size: 0.78rem;
        color: #666;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .property-specs i {
        color: var(--sakany-primary);
        font-size: 0.8rem;
    }

    .property-owner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .owner-avatar {
        width: 28px;
        height: 28px;
        background: var(--sakany-primary);
        border-radius: 50%;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-details {
        background: transparent;
        border: 1.5px solid var(--sakany-primary);
        color: var(--sakany-primary);
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.25rem 0.9rem;
        transition: all 0.2s;
    }

    .btn-details:hover {
        background: var(--sakany-primary);
        color: #fff;
    }

    /* FEATURES */
    .features-section {
        background: #fff;
    }

    .feature-card {
        padding: 2rem 1.5rem;
        border-radius: 16px;
        background: #f8f9fa;
        transition: all 0.3s;
    }

    .feature-card:hover {
        background: #fef2f2;
        transform: translateY(-4px);
    }

    .feature-icon {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #fef2f2, #fde8e8);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: var(--sakany-primary);
        margin: 0 auto 1.2rem;
    }

    /* CTA */
    .cta-card {
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        border-radius: 20px;
        padding: 3.5rem 2rem;
        color: #fff;
    }

    .cta-card h2 { font-weight: 800; }

    .cta-card .text-muted { color: rgba(255,255,255,0.65) !important; }
</style>
