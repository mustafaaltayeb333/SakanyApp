@model IEnumerable<Sakany.Models.Contract>
@{
    ViewData["Title"] = "Contracts";
    var role = Context.Session.GetString("UserRole");
    var userId = Context.Session.GetString("UserID");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a1a2e">
                <i class="bi bi-file-earmark-text me-2 text-danger"></i>
                @(role == "Admin" ? "All Contracts" : "My Contracts")
            </h2>
            <p class="text-muted mb-0">@Model.Count() contract(s)</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-file-earmark-x display-1 text-muted opacity-25"></i>
            <p class="mt-3 text-muted">No contracts yet. Contracts are created automatically when a request is approved.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var c in Model)
            {
                <div class="col-lg-6">
                    <div class="contract-card">
                        <div class="contract-header">
                            <div>
                                <div class="contract-id">Contract #@c.ID[..8].ToUpper()</div>
                                <div class="contract-address">
                                    <i class="bi bi-buildings me-1"></i>@c.Property?.Address, @c.Property?.City
                                </div>
                            </div>
                            <span class="contract-status-badge
                                        @(c.Status == Sakany.Models.ContractStatus.Active ? "cs-active" :
                                                                    c.Status == Sakany.Models.ContractStatus.Expired ? "cs-expired" : "cs-canceled")">
                        @c.Status
                    </span>
                </div>

                        <div class="contract-body">
                            <div class="contract-row">
                                <span><i class="bi bi-person me-1 text-danger"></i>Tenant</span>
                                <strong>@c.Tenant?.Name</strong>
                            </div>
                            <div class="contract-row">
                                <span><i class="bi bi-key me-1 text-danger"></i>Owner</span>
                                <strong>@c.Owner?.Name</strong>
                            </div>
                            <div class="contract-row">
                                <span><i class="bi bi-calendar-check me-1 text-danger"></i>Start</span>
                                <strong>@c.StartDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="contract-row">
                                <span><i class="bi bi-calendar-x me-1 text-danger"></i>End</span>
                                <strong>@(c.EndDate?.ToString("dd MMM yyyy") ?? "Open-ended")</strong>
                            </div>
                            <div class="contract-row">
                                <span><i class="bi bi-cash-stack me-1 text-danger"></i>Amount</span>
                                <strong class="text-danger">EGP @c.Amount.ToString("N0") / mo</strong>
                            </div>
                        </div>

                        <div class="contract-footer">
                            <a asp-action="Details" asp-route-id="@c.ID" class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                    @if (role == "Admin" && c.Status == Sakany.Models.ContractStatus.Active)
                            {
                                <a asp-action="Edit" asp-route-id="@c.ID" class="btn btn-sm btn-warning flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .contract-card {
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 16px rgba(0,0,0,.07);
        height: 100%;
    }

    .contract-header {
        background: linear-gradient(135deg,#1a1a2e,#0f3460);
        color: #fff;
        padding: 1.1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .contract-id {
        font-weight: 800;
        font-size: .95rem;
        letter-spacing: .05em;
    }

    .contract-address {
        font-size: .8rem;
        opacity: .75;
        margin-top: .2rem;
    }

    .contract-status-badge {
        font-size: .72rem;
        font-weight: 700;
        padding: .25rem .7rem;
        border-radius: 20px;
        flex-shrink: 0;
    }

    .cs-active {
        background: #d4edda;
        color: #155724;
    }

    .cs-expired {
        background: #fff3cd;
        color: #856404;
    }

    .cs-canceled {
        background: #f8d7da;
        color: #721c24;
    }

    .contract-body {
        padding: 1rem 1.25rem;
    }

    .contract-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .45rem 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: .88rem;
        color: #555;
    }

        .contract-row:last-child {
            border-bottom: none;
        }

    .contract-footer {
        padding: .75rem 1.25rem;
        border-top: 1px solid #f0f0f0;
        display: flex;
        gap: .5rem;
    }
</style>
