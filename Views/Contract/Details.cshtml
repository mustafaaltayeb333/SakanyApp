@model Sakany.Models.Contract
@{
    ViewData["Title"] = "Contract Details";
    var role = Context.Session.GetString("UserRole");
}

<div class="container py-4" style="max-width:680px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
        <button onclick="window.print()" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-printer me-1"></i>Print Contract
        </button>
    </div>

    <div class="contract-doc" id="printArea">
        <!-- HEADER -->
        <div class="contract-doc-header">
            <div class="contract-logo">Sakany</div>
            <div class="text-end">
                <div class="fw-bold" style="font-size:1.1rem">RENTAL CONTRACT</div>
                <div class="text-muted small">#@Model.ID[..8].ToUpper()</div>
            </div>
        </div>

        <!-- STATUS BANNER -->
        <div class="contract-status-banner
            @(Model.Status == Sakany.Models.ContractStatus.Active ? "banner-active" :
                           Model.Status == Sakany.Models.ContractStatus.Expired ? "banner-expired" : "banner-canceled")">
            <i class="bi @(Model.Status == Sakany.Models.ContractStatus.Active ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
            Contract Status: <strong>@Model.Status</strong>
        </div>

        <!-- PROPERTY -->
        <div class="contract-section">
            <div class="contract-section-title">Property</div>
            <div class="contract-detail-row">
                <span>Address</span><strong>@Model.Property?.Address</strong>
            </div>
            <div class="contract-detail-row">
                <span>City</span><strong>@Model.Property?.City</strong>
            </div>
            <div class="contract-detail-row">
                <span>Type</span><strong>@Model.Property?.Type</strong>
            </div>
        </div>

        <!-- PARTIES -->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <div class="party-card">
                    <div class="party-label"><i class="bi bi-key me-1"></i>Owner</div>
                    <div class="party-name">@Model.Owner?.Name</div>
                    <div class="party-contact">@Model.Owner?.Email</div>
                    <div class="party-contact">@Model.Owner?.Phone</div>
                </div>
            </div>
            <div class="col-6">
                <div class="party-card">
                    <div class="party-label"><i class="bi bi-person me-1"></i>Tenant</div>
                    <div class="party-name">@Model.Tenant?.Name</div>
                    <div class="party-contact">@Model.Tenant?.Email</div>
                    <div class="party-contact">@Model.Tenant?.Phone</div>
                </div>
            </div>
        </div>

        <!-- TERMS -->
        <div class="contract-section">
            <div class="contract-section-title">Contract Terms</div>
            <div class="contract-detail-row">
                <span>Start Date</span><strong>@Model.StartDate.ToString("dd MMMM yyyy")</strong>
            </div>
            <div class="contract-detail-row">
                <span>End Date</span><strong>@(Model.EndDate?.ToString("dd MMMM yyyy") ?? "Open-ended")</strong>
            </div>
            <div class="contract-detail-row">
                <span>Monthly Rent</span>
                <strong class="text-danger fs-5">EGP @Model.Amount.ToString("N0")</strong>
            </div>
            @if (Model.StartDate != default && Model.EndDate.HasValue)
            {
                var months = (int)Math.Ceiling((Model.EndDate.Value - Model.StartDate).TotalDays / 30);
                <div class="contract-detail-row">
                    <span>Duration</span><strong>@months month(s)</strong>
                </div>
                <div class="contract-detail-row">
                    <span>Total Value</span>
                    <strong class="text-danger">EGP @((Model.Amount * months).ToString("N0"))</strong>
                </div>
            }
        </div>

        <!-- TERMS TEXT -->
        <div class="contract-terms-text">
            <p>
                This rental contract is entered into between the Owner and Tenant named above for the property listed.
                The Tenant agrees to pay the monthly rent on time and maintain the property in good condition.
                This contract is legally binding upon approval and signature of both parties.
            </p>
            <p class="mb-0">Generated automatically by <strong>Sakany</strong> on @DateTime.Now.ToString("dd MMM yyyy").</p>
        </div>

        <!-- SIGNATURES -->
        <div class="row g-4 mt-2">
            <div class="col-6 text-center">
                <div class="sig-line"></div>
                <div class="sig-label">Owner Signature</div>
                <div class="sig-name">@Model.Owner?.Name</div>
            </div>
            <div class="col-6 text-center">
                <div class="sig-line"></div>
                <div class="sig-label">Tenant Signature</div>
                <div class="sig-name">@Model.Tenant?.Name</div>
            </div>
        </div>
    </div>

    @if (role == "Admin")
    {
        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">
                <i class="bi bi-pencil me-2"></i>Edit Contract Status
            </a>
        </div>
    }
</div>

<style>
    .contract-doc {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.1);
    }

    .contract-doc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f0f0f0;
    }

    .contract-logo {
        font-size: 1.6rem;
        font-weight: 800;
        color: #e74c3c;
    }

    .contract-status-banner {
        border-radius: 10px;
        padding: .75rem 1rem;
        margin-bottom: 1.5rem;
        font-size: .9rem;
    }

    .banner-active {
        background: #d4edda;
        color: #155724;
    }

    .banner-expired {
        background: #fff3cd;
        color: #856404;
    }

    .banner-canceled {
        background: #f8d7da;
        color: #721c24;
    }

    .contract-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
    }

    .contract-section-title {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #e74c3c;
        margin-bottom: .75rem;
    }

    .contract-detail-row {
        display: flex;
        justify-content: space-between;
        padding: .4rem 0;
        border-bottom: 1px solid #ebebeb;
        font-size: .9rem;
        color: #555;
    }

        .contract-detail-row:last-child {
            border-bottom: none;
        }

    .party-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: .9rem 1rem;
        height: 100%;
    }

    .party-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #e74c3c;
        margin-bottom: .4rem;
    }

    .party-name {
        font-weight: 700;
        font-size: .95rem;
        color: #1a1a2e;
    }

    .party-contact {
        font-size: .8rem;
        color: #777;
    }

    .contract-terms-text {
        border: 1px dashed #dee2e6;
        border-radius: 10px;
        padding: 1rem;
        background: #fafafa;
        font-size: .83rem;
        color: #666;
        line-height: 1.6;
        margin-top: 1rem;
    }

    .sig-line {
        border-bottom: 2px solid #1a1a2e;
        margin: 0 auto 0.5rem;
        width: 70%;
        margin-top: 2rem;
    }

    .sig-label {
        font-size: .75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .sig-name {
        font-size: .88rem;
        font-weight: 600;
        color: #1a1a2e;
    }

    @@media print {
        .btn, a.btn

    {
        display: none !important;
    }

    .container {
        max-width: 100% !important;
    }

    .contract-doc {
        box-shadow: none;
        border: 1px solid #ddd;
    }

    }
</style>
