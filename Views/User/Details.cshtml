@model Sakany.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>User Details</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-person-fill display-5"></i>
                        </div>
                        <h4 class="mb-1">@Model.Name</h4>
                        <span class="badge rounded-pill
                            @(Model.Role == UserRole.Admin ? "bg-danger" :
                              Model.Role == UserRole.Owner ? "bg-primary" : "bg-info text-dark") px-3 py-2">
                            <i class="bi bi-shield-fill me-1"></i>@Model.Role
                        </span>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="border rounded p-3">
                                <small class="text-muted text-uppercase fw-semibold">Email</small>
                                <p class="mb-0">
                                    <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                                </p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded p-3">
                                <small class="text-muted text-uppercase fw-semibold">Phone</small>
                                <p class="mb-0">
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <span>@Model.Phone</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded p-3">
                                <small class="text-muted text-uppercase fw-semibold">User ID</small>
                                <p class="mb-0 text-muted small text-break">@Model.ID</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded p-3">
                                <small class="text-muted text-uppercase fw-semibold">Account Type</small>
                                <p class="mb-0 fw-semibold">@Model.Role</p>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
