@model Sakany.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete User</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-4"></i>
                        <div>
                            Are you sure you want to delete this user? This action <strong>cannot be undone</strong>.
                        </div>
                    </div>

                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="bi bi-person-fill display-6"></i>
                        </div>
                        <h5 class="mb-1">@Model.Name</h5>
                        <span class="badge rounded-pill
                            @(Model.Role == UserRole.Admin ? "bg-danger" :
                              Model.Role == UserRole.Owner ? "bg-primary" : "bg-info text-dark") px-3">
                            @Model.Role
                        </span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="border rounded p-3 bg-light">
                                <small class="text-muted text-uppercase">Email</small>
                                <p class="mb-0 fw-semibold text-break">@Model.Email</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="border rounded p-3 bg-light">
                                <small class="text-muted text-uppercase">Phone</small>
                                <p class="mb-0 fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</p>
                            </div>
                        </div>
                    </div>

                    @if (Model.ID == Context.Session.GetString("UserID"))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-ban-fill me-2"></i><strong>Action blocked:</strong> You cannot delete your own account.
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                        @if (Model.ID != Context.Session.GetString("UserID"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ID" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
