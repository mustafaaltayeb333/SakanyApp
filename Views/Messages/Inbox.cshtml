@{
    ViewData["Title"] = "Messages";
    var threads = ViewBag.Threads as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="container py-4" style="max-width:720px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a1a2e">
                <i class="bi bi-chat-dots me-2 text-danger"></i>Messages
            </h2>
            <p class="text-muted mb-0">Your conversations</p>
        </div>
    </div>

    @if (!threads.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-chat-dots display-1 text-muted opacity-25"></i>
            <p class="mt-3 text-muted">No conversations yet.</p>
            <a asp-controller="Property" asp-action="Index" class="btn btn-danger">Browse Properties</a>
        </div>
    }
    else
    {
        <div class="thread-list">
            @foreach (var t in threads)
            {
                var property = t.Property as Sakany.Models.Property;
                var otherUser = t.OtherUser as Sakany.Models.User;
                var lastMsg = t.LastMessage as Sakany.Models.Message;
                int unread = (int)t.UnreadCount;

                <a asp-controller="Messages" asp-action="Conversation"
                   asp-route-propertyId="@property?.ID"
                   asp-route-otherUserId="@otherUser?.ID"
                   class="thread-item @(unread > 0 ? "thread-unread" : "")">

                    <div class="thread-avatar">@(otherUser?.Name?[0].ToString().ToUpper() ?? "?")</div>

                    <div class="thread-body">
                        <div class="d-flex justify-content-between">
                            <span class="thread-name">@otherUser?.Name</span>
                            <span class="thread-time">@lastMsg?.Date.ToString("dd MMM")</span>
                        </div>
                        <div class="thread-property">
                            <i class="bi bi-buildings me-1"></i>@property?.Address
                        </div>
                        <div class="thread-preview">@lastMsg?.MessageText</div>
                    </div>

                    @if (unread > 0)
                    {
                        <div class="thread-badge">@unread</div>
                    }
                </a>
            }
        </div>
    }
</div>

<style>
    .thread-list {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .thread-item {
        display: flex;
        align-items: center;
        gap: .9rem;
        background: #fff;
        border-radius: 14px;
        padding: 1rem 1.1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        text-decoration: none;
        color: inherit;
        border-left: 4px solid transparent;
        transition: .2s;
    }

        .thread-item:hover {
            transform: translateX(4px);
            box-shadow: 0 4px 16px rgba(0,0,0,.1);
            color: inherit;
        }

    .thread-unread {
        border-left-color: #e74c3c;
        background: #fff9f9;
    }

    .thread-avatar {
        width: 44px;
        height: 44px;
        background: #e74c3c;
        border-radius: 50%;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .thread-body {
        flex: 1;
        min-width: 0;
    }

    .thread-name {
        font-weight: 700;
        font-size: .92rem;
        color: #1a1a2e;
    }

    .thread-time {
        font-size: .75rem;
        color: #aaa;
    }

    .thread-property {
        font-size: .78rem;
        color: #e74c3c;
        margin: .1rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .thread-preview {
        font-size: .83rem;
        color: #777;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .thread-badge {
        background: #e74c3c;
        color: #fff;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        padding: .15rem .55rem;
        flex-shrink: 0;
    }
</style>
