@{
    ViewData["Title"] = "Conversation";
    var property = ViewBag.Property as Sakany.Models.Property;
    var otherUser = ViewBag.OtherUser as Sakany.Models.User;
    var messages = ViewBag.Messages as List<Sakany.Models.Message> ?? new();
    var myId = Context.Session.GetString("UserID");
}

<div class="container py-3" style="max-width:720px">

    <!-- HEADER -->
    <div class="chat-header">
        <a asp-action="Inbox" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div class="chat-header-avatar">@(otherUser?.Name?[0].ToString().ToUpper() ?? "?")</div>
        <div class="flex-fill">
            <div class="fw-bold">@otherUser?.Name</div>
            <div class="small text-muted">
                <i class="bi bi-buildings me-1"></i>@property?.Address, @property?.City
            </div>
        </div>
        <a asp-controller="Property" asp-action="Details" asp-route-id="@property?.ID"
           class="btn btn-sm btn-outline-danger">
            View Property
        </a>
    </div>

    <!-- MESSAGES -->
    <div class="chat-window" id="chatWindow">
        @if (!messages.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-chat display-3 opacity-25"></i>
                <p class="mt-2">No messages yet. Say hello!</p>
            </div>
        }
        else
        {
            string? lastDate = null;
            @foreach (var msg in messages)
            {
                var isMe = msg.SenderID == myId;
                var dateLabel = msg.Date.ToString("dd MMM yyyy");

                if (lastDate != dateLabel)
                {
                    lastDate = dateLabel;
                    <div class="date-divider"><span>@dateLabel</span></div>
                }

                <div class="msg-row @(isMe ? "msg-mine" : "msg-theirs")">
                    @if (!isMe)
                    {
                        <div class="msg-avatar">@(msg.Sender?.Name?[0].ToString() ?? "?")</div>
                    }
                    <div class="msg-bubble @(isMe ? "bubble-mine" : "bubble-theirs")">
                        @msg.MessageText
                        <div class="msg-time">
                            @msg.Date.ToString("hh:mm tt")
                            @if (isMe)
                            {
                                <i class="bi @(msg.IsRead ? "bi-check2-all text-primary" : "bi-check2") ms-1"></i>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- INPUT -->
    <div class="chat-input-bar">
        <form asp-action="Send" method="post" class="d-flex gap-2 align-items-end w-100">
            @Html.AntiForgeryToken()
            <input type="hidden" name="propertyId" value="@property?.ID" />
            <input type="hidden" name="receiverId" value="@otherUser?.ID" />
            <textarea name="messageText" id="msgInput" class="form-control chat-textarea"
                      placeholder="Type a message…" rows="1"
                      onkeydown="handleEnter(event)"></textarea>
            <button type="submit" class="btn btn-danger btn-send">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>
</div>

<style>
    .chat-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        background: #fff;
        border-radius: 14px;
        padding: .9rem 1.1rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        margin-bottom: .75rem;
    }

    .chat-header-avatar {
        width: 40px;
        height: 40px;
        background: #e74c3c;
        border-radius: 50%;
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .chat-window {
        background: #f0f2f5;
        border-radius: 14px;
        padding: 1rem;
        min-height: 400px;
        max-height: 55vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        margin-bottom: .75rem;
    }

    .date-divider {
        text-align: center;
        margin: .5rem 0;
    }

        .date-divider span {
            background: #dde;
            border-radius: 20px;
            padding: .2rem .85rem;
            font-size: .75rem;
            color: #666;
        }

    .msg-row {
        display: flex;
        align-items: flex-end;
        gap: .5rem;
    }

    .msg-mine {
        flex-direction: row-reverse;
    }

    .msg-theirs {
        flex-direction: row;
    }

    .msg-avatar {
        width: 28px;
        height: 28px;
        background: #e74c3c;
        border-radius: 50%;
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-bottom: 2px;
    }

    .msg-bubble {
        max-width: 72%;
        padding: .55rem .85rem;
        border-radius: 16px;
        font-size: .9rem;
        line-height: 1.45;
        position: relative;
    }

    .bubble-mine {
        background: #e74c3c;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .bubble-theirs {
        background: #fff;
        color: #2d2d2d;
        border-bottom-left-radius: 4px;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
    }

    .msg-time {
        font-size: .68rem;
        margin-top: .25rem;
        opacity: .7;
        text-align: right;
    }

    .chat-input-bar {
        background: #fff;
        border-radius: 14px;
        padding: .75rem 1rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        display: flex;
    }

    .chat-textarea {
        border-radius: 20px;
        border: 1.5px solid #e9ecef;
        resize: none;
        padding: .55rem 1rem;
        font-size: .9rem;
        max-height: 120px;
        overflow-y: auto;
    }

        .chat-textarea:focus {
            border-color: #e74c3c;
            box-shadow: none;
        }

    .btn-send {
        border-radius: 50%;
        width: 44px;
        height: 44px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<script>
    // Scroll to bottom on load
    const cw = document.getElementById('chatWindow');
    if (cw) cw.scrollTop = cw.scrollHeight;

    // Send on Enter (Shift+Enter = newline)
    function handleEnter(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            e.target.closest('form').submit();
        }
    }

    // Auto-resize textarea
    const ta = document.getElementById('msgInput');
    if (ta) {
        ta.addEventListener('input', () => {
            ta.style.height = 'auto';
            ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
        });
    }
</script>
