@model List<Sakany.Models.Request>
@{
    ViewData["Title"] = "Requests";
    var role = Context.Session.GetString("UserRole");

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;

    string PageUrl(int page) =>
        $"?pageNumber={page}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a1a2e">
                <i class="bi bi-file-text me-2 text-danger"></i>
                @if (role == "Tenant")
                {
                    <text>My Requests</text>
                }
                else if (role == "Owner")
                {
                    <text>Requests on My Properties</text>
                }
                else
                {
                    <text>All Requests</text>
                }
            </h2>
            <p class="text-muted mb-0">@totalCount request(s)</p>
        </div>
        @if (role == "Tenant")
        {
            <a asp-action="Create" class="btn btn-danger px-4">
                <i class="bi bi-plus-lg me-2"></i>New Request
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-file-text display-1 text-muted opacity-25"></i>
            <p class="mt-3 text-muted">No requests found.</p>
            @if (role == "Tenant")
            {
                <a asp-action="Create" class="btn btn-danger">Submit a Request</a>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8f9fa">
                        <tr>
                            @if (role != "Tenant")
                            {
                                <th class="ps-3">Tenant</th>
                            }
                            <th>Property</th>
                            <th>City</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (role != "Tenant")
                                {
                                    <td class="ps-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="req-avatar">@(item.Client?.Name?[0].ToString() ?? "?")</div>
                                            <span class="small fw-600">@item.Client?.Name</span>
                                        </div>
                                    </td>
                                }
                                <td>
                                    <div class="small fw-600">@item.Property?.Address</div>
                                    @if (role == "Tenant")
                                    {
                                        <div class="text-muted" style="font-size:.75rem">Owner: @item.Property?.Owner?.Name</div>
                                    }
                            </td>
                            <td class="small text-muted">@item.Property?.City</td>
                            <td class="small text-muted">@item.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="status-badge
                                                    @(item.Status == Sakany.Models.RequestStatus.Pending ? "status-pending" :
                                                                                        item.Status == Sakany.Models.RequestStatus.Approved ? "status-approved" : "status-rejected")">
                                @item.Status
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if ((role == "Owner" || role == "Admin") && item.Status == Sakany.Models.RequestStatus.Pending)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ID"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-check2-square"></i>
                                            </a>
                                        }
                                        @if (role == "Admin")
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.ID"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── PAGINATION ────────────────────────────────── -->
        @if (totalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-center align-items-center gap-2">

                @if (currentPage > 1)
                {
                    <a href="@PageUrl(currentPage - 1)" class="page-btn page-btn-arrow">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                }
                else
                {
                    <span class="page-btn page-btn-arrow disabled">
                        <i class="bi bi-chevron-left"></i>
                    </span>
                }

                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);
                }

                @if (startPage > 1)
                {
                    <a href="@PageUrl(1)" class="page-btn">1</a>
                    @if (startPage > 2)
                    {
                        <span class="page-dots">…</span>
                    }
                }

                @for (int p = startPage; p <= endPage; p++)
                {
                    @if (p == currentPage)
                    {
                        <span class="page-btn page-btn-active">@p</span>
                    }
                    else
                    {
                        <a href="@PageUrl(p)" class="page-btn">@p</a>
                    }
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="page-dots">…</span>
                    }
                    <a href="@PageUrl(totalPages)" class="page-btn">@totalPages</a>
                }

                @if (currentPage < totalPages)
                {
                    <a href="@PageUrl(currentPage + 1)" class="page-btn page-btn-arrow">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }
                else
                {
                    <span class="page-btn page-btn-arrow disabled">
                        <i class="bi bi-chevron-right"></i>
                    </span>
                }

            </nav>

            <p class="text-center text-muted small mt-2">
                Page @currentPage of @totalPages &nbsp;·&nbsp; @totalCount requests total
            </p>
        }
    }
</div>

<style>
    .fw-600 {
        font-weight: 600;
    }

    .req-avatar {
        width: 28px;
        height: 28px;
        background: #e74c3c;
        border-radius: 50%;
        color: #fff;
        font-size: .75rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .status-badge {
        font-size: .75rem;
        font-weight: 600;
        padding: .25rem .75rem;
        border-radius: 20px;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #721c24;
    }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        padding: 0 .6rem;
        border-radius: 8px;
        font-size: .875rem;
        font-weight: 500;
        color: #444;
        background: #fff;
        border: 1px solid #dee2e6;
        text-decoration: none;
        transition: all .2s;
    }

        .page-btn:hover:not(.disabled):not(.page-btn-active) {
            background: #f8f9fa;
            border-color: #e74c3c;
            color: #e74c3c;
        }

    .page-btn-active {
        background: #e74c3c;
        border-color: #e74c3c;
        color: #fff !important;
        font-weight: 700;
        pointer-events: none;
    }

    .page-btn.disabled {
        opacity: .4;
        pointer-events: none;
    }

    .page-dots {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 38px;
        color: #aaa;
        font-size: .85rem;
    }
</style>