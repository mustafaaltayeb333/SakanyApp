@model IEnumerable<Sakany.Models.Property>
@{
    ViewData["Title"] = ViewBag.PageTitle ?? "Properties";
    var viewMode = ViewBag.ViewMode as string ?? "all";
    var userRole = Context.Session.GetString("UserRole");
    var isOwner = userRole == "Owner";
    var isAdmin = userRole == "Admin";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-buildings me-2 text-primary"></i>@ViewBag.PageTitle</h2>
            <p class="text-muted mb-0"><span id="listingCount">@Model.Count()</span> listing@(Model.Count() != 1 ? "s" : "") found</p>
        </div>

        @if (isOwner)
        {
            <div class="btn-group shadow-sm" role="group">
                <a asp-action="Index" asp-route-viewMode="mine"
                   class="btn @(viewMode == "mine" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-person-video me-1"></i>My Properties
                </a>
                <a asp-action="Index" asp-route-viewMode="others"
                   class="btn @(viewMode == "others" ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-globe me-1"></i>Other Listings
                </a>
            </div>
        }

        @if (isOwner || isAdmin)
        {
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i>Add Property
            </a>
        }
    </div>

    <!-- Search, Filters & Sort -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-end" id="filterForm">
                <input type="hidden" name="viewMode" value="@viewMode" />
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-semibold text-muted">City</label>
                    <select name="city" class="form-select">
                        <option value="">All Cities</option>
                        @foreach (var c in ViewBag.Cities as List<string> ?? new List<string>())
                        {
                            <option value="@c" selected="@(Context.Request.Query["city"] == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-6">
                    <label class="form-label small fw-semibold text-muted">Type</label>
                    <select name="type" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var t in ViewBag.Types as List<string> ?? new List<string>())
                        {
                            <option value="@t" selected="@(Context.Request.Query["type"] == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-8">
                    <label class="form-label small fw-semibold text-muted">Keyword</label>
                    <input type="text" name="search" class="form-control" placeholder="Search address, city..." value="@Context.Request.Query["search"]" />
                </div>
                <div class="col-md-2 col-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                </div>
            </form>

            <!-- Dynamic Sort Bar -->
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small fw-semibold"><i class="bi bi-sort-down me-1"></i>Sort By:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary sort-btn active" data-sort="default" onclick="sortProperties('default', this)">
                            <i class="bi bi-shuffle me-1"></i>Default
                        </button>
                        <button type="button" class="btn btn-outline-secondary sort-btn" data-sort="price" data-dir="asc" onclick="sortProperties('price', this)">
                            <i class="bi bi-currency-dollar me-1"></i>Price <i class="bi bi-arrow-up sort-icon"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary sort-btn" data-sort="date" data-dir="desc" onclick="sortProperties('date', this)">
                            <i class="bi bi-calendar me-1"></i>Date <i class="bi bi-arrow-down sort-icon"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary sort-btn" data-sort="area" data-dir="asc" onclick="sortProperties('area', this)">
                            <i class="bi bi-arrows-angle-expand me-1"></i>Area <i class="bi bi-arrow-up sort-icon"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary sort-btn" data-sort="bedrooms" data-dir="desc" onclick="sortProperties('bedrooms', this)">
                            <i class="bi bi-bed me-1"></i>Rooms <i class="bi bi-arrow-down sort-icon"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Property Grid -->
    <div id="propertyGrid">
        @if (!Model.Any())
        {
            <div class="text-center py-5" id="emptyState">
                <i class="bi bi-buildings display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">No properties found</h4>
                <p class="text-muted">Try adjusting your filters or add a new listing.</p>
            </div>
        }
        else
        {
            <div class="row g-4" id="propertyList">
                @foreach (var item in Model)
                {
                    var isMyProperty = item.OwnerID == Context.Session.GetString("UserID");
                    var readOnly = isOwner && viewMode == "others";

                    <div class="col-lg-4 col-md-6 property-card-item"
                         data-price="@item.Price"
                         data-date="@item.CreatedAt.Ticks"
                         data-area="@item.Area"
                         data-bedrooms="@item.BedRooms">
                        <div class="card h-100 border-0 shadow-sm overflow-hidden property-card">
                            <!-- Image -->
                            <div class="position-relative" style="height: 220px; background: #f0f0f0;">
                                @if (item.Image?.Any() == true)
                                {
                                    <img src="@item.Image.First().ImageURL" class="w-100 h-100 object-fit-cover" alt="Property photo" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                        <i class="bi bi-image display-4"></i>
                                    </div>
                                }

                                <div class="position-absolute top-0 start-0 m-2 d-flex gap-1">
                                    <span class="badge bg-dark bg-opacity-75">@item.Type</span>
                                    <span class="badge @(item.Status == PropertyStatus.Available ? "bg-success" : item.Status == PropertyStatus.Rented ? "bg-warning text-dark" : "bg-secondary")">
                                        @item.Status
                                    </span>
                                </div>

                                @if (readOnly)
                                {
                                    <div class="position-absolute top-0 end-0 m-2">
                                        <span class="badge bg-info"><i class="bi bi-eye me-1"></i>Read Only</span>
                                    </div>
                                }
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0 text-truncate" style="max-width: 75%;">@item.Address</h5>
                                    <span class="fw-bold text-primary">@item.Price.ToString("C0")</span>
                                </div>

                                <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@item.City</p>

                                <div class="d-flex gap-3 text-muted small mb-3">
                                    <span><i class="bi bi-bed me-1"></i>@item.BedRooms</span>
                                    <span><i class="bi bi-droplet me-1"></i>@item.BathRooms</span>
                                    <span><i class="bi bi-arrows-angle-expand me-1"></i>@item.Area m²</span>
                                </div>

                                <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.AvailableRooms rooms available · @item.Type in @item.City
                                </p>

                                <div class="d-flex gap-2 mt-auto pt-2 border-top">
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm flex-grow-1">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>

                                    @if (!readOnly && (isAdmin || isMyProperty))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    else if (readOnly && userRole == "Tenant")
                                    {
                                        <a asp-controller="Requests" asp-action="Create" asp-route-propertyId="@item.ID" class="btn btn-primary btn-sm flex-grow-1">
                                            <i class="bi bi-send me-1"></i>Request
                                        </a>
                                    }
                                    else if (readOnly)
                                    {
                                        <span class="btn btn-outline-secondary btn-sm flex-grow-1 disabled">
                                            <i class="bi bi-lock me-1"></i>Owner Only
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                                <small class="text-muted">
                                    <i class="bi bi-person me-1"></i>Listed by @item.Owner?.Name
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .property-card { transition: transform 0.2s, box-shadow 0.2s; }
    .property-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important; }
    .object-fit-cover { object-fit: cover; }
    .sort-btn.active { background: var(--bs-primary); color: white; border-color: var(--bs-primary); }
    .sort-btn.active .sort-icon { display: inline-block !important; }
    .sort-btn .sort-icon { display: none; }
</style>

@section Scripts {
    <script>
        function sortProperties(sortType, btn) {
            // Update active state
            document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const list = document.getElementById('propertyList');
            if (!list) return;

            const cards = Array.from(list.querySelectorAll('.property-card-item'));

            if (sortType === 'default') {
                // Reload original order from data attribute or just reload page
                location.reload();
                return;
            }

            let direction = btn.getAttribute('data-dir') || 'asc';
            const icon = btn.querySelector('.sort-icon');

            // Toggle direction on repeated clicks
            if (btn.getAttribute('data-last-sort') === sortType) {
                direction = direction === 'asc' ? 'desc' : 'asc';
                btn.setAttribute('data-dir', direction);
            } else {
                // Reset all other buttons
                document.querySelectorAll('.sort-btn').forEach(b => {
                    if (b !== btn) b.setAttribute('data-last-sort', '');
                });
            }
            btn.setAttribute('data-last-sort', sortType);

            // Update icon
            icon.className = direction === 'asc' ? 'bi bi-arrow-up sort-icon' : 'bi bi-arrow-down sort-icon';

            cards.sort((a, b) => {
                let valA, valB;

                switch (sortType) {
                    case 'price':
                        valA = parseFloat(a.getAttribute('data-price'));
                        valB = parseFloat(b.getAttribute('data-price'));
                        break;
                    case 'date':
                        valA = parseInt(a.getAttribute('data-date'));
                        valB = parseInt(b.getAttribute('data-date'));
                        break;
                    case 'area':
                        valA = parseFloat(a.getAttribute('data-area'));
                        valB = parseFloat(b.getAttribute('data-area'));
                        break;
                    case 'bedrooms':
                        valA = parseInt(a.getAttribute('data-bedrooms'));
                        valB = parseInt(b.getAttribute('data-bedrooms'));
                        break;
                    default:
                        return 0;
                }

                if (direction === 'asc') {
                    return valA - valB;
                } else {
                    return valB - valA;
                }
            });

            // Re-append in sorted order with animation
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    list.appendChild(card);
                    card.style.transition = 'all 0.3s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 50);
            });
        }
    </script>
}