@model Sakany.Models.Property
@{
    ViewData["Title"] = "List a Property";
    var role = Context.Session.GetString("UserRole");
}

<div class="container py-4" style="max-width:760px">
    <div class="form-card">
        <div class="form-card-header">
            <i class="bi bi-plus-circle me-2"></i>List a New Property
        </div>
        <div class="form-card-body">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                <!-- Owner (Admin only picks, Owner is auto-assigned) -->
                @if (role == "Admin")
                {
                    <div class="mb-3">
                        <label class="form-label fw-600">Owner</label>
                        <select asp-for="OwnerID" asp-items="@(ViewData["OwnerID"] as SelectList)"
                                class="form-select">
                            <option value="">— Select Owner —</option>
                        </select>
                        <span asp-validation-for="OwnerID" class="text-danger small"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="OwnerID" value="@ViewBag.OwnerID" />
                }

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-600"></label>
                        <input asp-for="Address" class="form-control" placeholder="123 El Nile St, Maadi" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-600"></label>
                        <input asp-for="City" class="form-control" placeholder="Cairo" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-600">Price (EGP/month)</label>
                        <input asp-for="Price" type="number" step="100" class="form-control" placeholder="5000" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label fw-600"></label>
                        <select asp-for="Type" asp-items="Html.GetEnumSelectList<Sakany.Models.PropertyType>()"
                                class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BedRooms" class="form-label fw-600">Bedrooms</label>
                        <input asp-for="BedRooms" type="number" min="1" class="form-control" />
                        <span asp-validation-for="BedRooms" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BathRooms" class="form-label fw-600">Bathrooms</label>
                        <input asp-for="BathRooms" type="number" min="1" class="form-control" />
                        <span asp-validation-for="BathRooms" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AvailableRooms" class="form-label fw-600">Available Rooms</label>
                        <input asp-for="AvailableRooms" type="number" min="0" class="form-control" />
                        <span asp-validation-for="AvailableRooms" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Area" class="form-label fw-600">Area (m²)</label>
                        <input asp-for="Area" type="number" step="0.5" class="form-control" />
                        <span asp-validation-for="Area" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-check-lg me-2"></i>List Property
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .fw-600 {
        font-weight: 600;
    }

    .form-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .form-card-header {
        background: linear-gradient(135deg,#1a1a2e,#0f3460);
        color: #fff;
        padding: 1.25rem 1.5rem;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .form-card-body {
        padding: 1.75rem 1.5rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #e74c3c;
        box-shadow: 0 0 0 .2rem rgba(231,76,60,.12);
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
