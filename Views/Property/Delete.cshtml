@model Sakany.Models.Property

@{
    ViewData["Title"] = "Delete Property";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <!-- Danger Card -->
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <h5 class="mb-0">Delete Confirmation</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-4"></i>
                        <div>
                            <strong>Warning:</strong> This action is irreversible. Deleting this property will also remove all associated images, amenities links, and related data.
                        </div>
                    </div>

                    <!-- Property Summary -->
                    <div class="mb-4">
                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Target Asset Summary</h6>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="border rounded p-3 bg-light">
                                    <small class="text-muted text-uppercase">Title / Address</small>
                                    <p class="mb-0 fw-semibold">@Model.Address</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="border rounded p-3 bg-light">
                                    <small class="text-muted text-uppercase">City</small>
                                    <p class="mb-0 fw-semibold">@Model.City</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="border rounded p-3 bg-light">
                                    <small class="text-muted text-uppercase">Price</small>
                                    <p class="mb-0 fw-semibold text-success">EGP @Model.Price.ToString("N0")</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="border rounded p-3 bg-light">
                                    <small class="text-muted text-uppercase">Type & Status</small>
                                    <p class="mb-0 fw-semibold">
                                        <span class="badge bg-info me-1">@Model.Type</span>
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    </p>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="border rounded p-3 bg-light text-center">
                                    <small class="text-muted text-uppercase">Bedrooms</small>
                                    <p class="mb-0 fw-bold fs-5">@Model.BedRooms</p>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="border rounded p-3 bg-light text-center">
                                    <small class="text-muted text-uppercase">Bathrooms</small>
                                    <p class="mb-0 fw-bold fs-5">@Model.BathRooms</p>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="border rounded p-3 bg-light text-center">
                                    <small class="text-muted text-uppercase">Area</small>
                                    <p class="mb-0 fw-bold fs-5">@Model.Area m<sup>2</sup></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Action Buttons -->
                    <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ID" />
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
