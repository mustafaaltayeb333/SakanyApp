@model Sakany.Models.Property

@{
    ViewData["Title"] = "Edit Property";
}

<h2>Edit Property</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="ID" />

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="OwnerID" class="form-label"></label>
                <select asp-for="OwnerID"
                        asp-items="@(ViewData["OwnerID"] as SelectList)"
                        class="form-select">
                </select>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>