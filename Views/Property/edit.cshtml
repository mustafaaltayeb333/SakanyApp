@model Sakany.Models.Property
@{
    ViewData["Title"] = "Edit Property";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Property</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <!-- Critical: Hidden ID field for correct binding -->
                        <input type="hidden" asp-for="ID" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="OwnerID" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Property Address -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Enter full address (min 10 characters)" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <input asp-for="City" class="form-control" placeholder="Enter city name" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <!-- Price -->
                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">EGP</span>
                                <input asp-for="Price" class="form-control" type="number" min="1" max="1000000" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <!-- Type Dropdown (Enum) -->
                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-semibold">Property Type</label>
                            <select asp-for="Type" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-select">
                            </select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>

                        <!-- Status Dropdown (Enum) -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Property Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PropertyStatus>()" class="form-select">
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- Bedrooms -->
                        <div class="mb-3">
                            <label asp-for="BedRooms" class="form-label fw-semibold">Bedrooms</label>
                            <input asp-for="BedRooms" class="form-control" type="number" min="1" max="50" />
                            <span asp-validation-for="BedRooms" class="text-danger"></span>
                        </div>

                        <!-- Bathrooms -->
                        <div class="mb-3">
                            <label asp-for="BathRooms" class="form-label fw-semibold">Bathrooms</label>
                            <input asp-for="BathRooms" class="form-control" type="number" min="1" max="50" />
                            <span asp-validation-for="BathRooms" class="text-danger"></span>
                        </div>

                        <!-- Available Rooms -->
                        <div class="mb-3">
                            <label asp-for="AvailableRooms" class="form-label fw-semibold">Available Rooms</label>
                            <input asp-for="AvailableRooms" class="form-control" type="number" min="0" max="50" />
                            <span asp-validation-for="AvailableRooms" class="text-danger"></span>
                        </div>

                        <!-- Area -->
                        <div class="mb-3">
                            <label asp-for="Area" class="form-label fw-semibold">Area (sqm)</label>
                            <input asp-for="Area" class="form-control" type="number" min="1" max="100000" />
                            <span asp-validation-for="Area" class="text-danger"></span>
                        </div>

                        <!-- Existing Images -->
                        @if (Model.Image != null && Model.Image.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Existing Images</label>
                                <div class="row g-2">
                                    @foreach (var img in Model.Image)
                                    {
                                        <div class="col-md-3 col-6">
                                            <div class="position-relative">
                                                <img src="@img.ImageURL" class="img-fluid rounded" style="height: 100px; object-fit: cover; width: 100%;" alt="Property image" />
                                                <div class="form-check position-absolute top-0 end-0 m-1">
                                                    <input type="checkbox" name="deleteImageIds" value="@img.ID" class="form-check-input" title="Delete this image" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <small class="text-muted">Check images to delete them</small>
                            </div>
                        }

                        <!-- Main Image Upload -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Main Image</label>
                            <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
                            <small class="text-muted">Upload a new main image (jpg, png, webp, gif)</small>
                        </div>

                        <!-- Main Image URL -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Or Main Image URL</label>
                            <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        </div>

                        <!-- Extra Images -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Extra Images</label>
                            <input type="file" name="extraImages" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp,.gif" />
                        </div>

                        <!-- Extra Image URLs -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Or Extra Image URLs</label>
                            <input type="text" name="extraUrls" class="form-control" placeholder="Comma-separated URLs" />
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
