@model Sakany.Models.User
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-gear me-2"></i>Edit Profile</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Account" asp-action="EditProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Read-only Email -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                            <small class="text-muted">Email cannot be changed</small>
                        </div>

                        <!-- Name -->
                        <div class="mb-3">
                            <label for="name" class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="name" id="name" class="form-control" value="@Model.Name" required maxlength="100" />
                            <span class="text-danger" data-valmsg-for="name"></span>
                        </div>

                        <!-- Phone -->
                        <div class="mb-3">
                            <label for="phone" class="form-label fw-semibold">Phone Number</label>
                            <input type="tel" name="phone" id="phone" class="form-control" value="@Model.Phone" maxlength="20" />
                            <small class="text-muted">Optional contact number</small>
                        </div>

                        <!-- Password Update -->
                        <div class="card bg-light border-0 mb-3">
                            <div class="card-body">
                                <h6 class="card-title"><i class="bi bi-shield-lock me-1"></i>Change Password (Optional)</h6>
                                <p class="text-muted small">Leave blank to keep your current password</p>
                                <div class="mb-0">
                                    <label for="newPassword" class="form-label fw-semibold">New Password</label>
                                    <input type="password" name="newPassword" id="newPassword" class="form-control" minlength="6" placeholder="Minimum 6 characters" />
                                    <small class="text-muted">Password must be at least 6 characters</small>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Profile
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
