@model Sakany.Models.Review

@{
    ViewData["Title"] = "Write a Review";
}

<div class="container py-4" style="max-width:560px">

    
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>

    <div class="form-card">

        <div class="form-card-header">
            <i class="bi bi-star me-2"></i>Write a Review
        </div>

        <div class="form-card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger small py-2">
                </div>

                <!-- Property -->
                <div class="mb-4">

                    <label class="form-label fw-600">
                        <i class="bi bi-buildings me-1 text-danger"></i>
                        Property (from your approved requests)
                    </label>

                    <select asp-for="RequestID"
                            asp-items="@(ViewData["RequestID"] as SelectList)"
                            class="form-select">

                        <option value="">
                            — Select property —
                        </option>

                    </select>

                    <span asp-validation-for="RequestID"
                          class="text-danger small">
                    </span>

                    <div class="form-text">
                        Only approved, un-reviewed rentals appear here.
                    </div>

                </div>

                <!-- Rating -->
                <div class="mb-4">

                    <label asp-for="Rate" class="form-label fw-600">
                        ⭐ Choose Your Rating
                    </label>

                    <select asp-for="Rate" class="form-select">

                        <option value="1">⭐ 1 - Poor</option>
                        <option value="2">⭐⭐ 2 - Fair</option>
                        <option value="3">⭐⭐⭐ 3 - Good</option>
                        <option value="4">⭐⭐⭐⭐ 4 - Very Good</option>
                        <option value="5">⭐⭐⭐⭐⭐ 5 - Excellent</option>

                    </select>

                    <span asp-validation-for="Rate"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Description -->
                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label fw-600">
                        Your Review
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Share your experience with this property...">
                </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning px-4">
                        <i class="bi bi-star me-2"></i>
                        Submit Review
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

<style>

    .fw-600 {
        font-weight: 600;
    }

    .form-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
    }

    .form-card-header {
        background: linear-gradient(135deg,#1a1a2e,#0f3460);
        color: white;
        padding: 1.25rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .form-card-body {
        padding: 1.75rem 1.5rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #e74c3c;
        box-shadow: 0 0 0 .2rem rgba(231,76,60,.12);
    }

</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
