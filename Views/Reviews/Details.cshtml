@model Sakany.Models.Review
@{
    ViewData["Title"] = "Review Details";
    var isMyReview = Model.ClientID == Context.Session.GetString("UserID");
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Reviews</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <!-- Review Header -->
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="reviewer-avatar-lg">
                                @(Model.Client?.Name?[0].ToString().ToUpper() ?? "U")
                            </div>
                            <div>
                                <h4 class="mb-1">@Model.Client?.Name</h4>
                                <p class="text-muted mb-0">
                                    <span class="badge bg-light text-dark border">@Model.Client?.Role</span>
                                    <span class="mx-2">·</span>
                                    <i class="bi bi-calendar me-1"></i>@Model.Date.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="rating-display mb-1">
                                <span class="display-4 fw-bold text-warning">@Model.Rate</span><span class="text-muted fs-4">/5</span>
                            </div>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Model.Rate ? "bi-star-fill text-warning" : "bi-star text-muted") fs-5"></i>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Review Body -->
                    <div class="my-4">
                        <h6 class="text-primary mb-3"><i class="bi bi-chat-quote me-2"></i>Feedback</h6>
                        @if (string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="text-muted fst-italic">No written feedback provided.</p>
                        }
                        else
                        {
                            <p class="fs-5 text-dark" style="line-height: 1.7;">@Model.Description</p>
                        }
                    </div>

                    <hr />

                    <!-- Property Context -->
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            @if (Model.Property?.Image?.Any() == true)
                            {
                                <img src="@Model.Property.Image.First().ImageURL" class="w-100 rounded" style="height: 150px; object-fit: cover;" alt="Property" />
                            }
                            else
                            {
                                <div class="w-100 rounded bg-light d-flex align-items-center justify-content-center" style="height: 150px;">
                                    <i class="bi bi-image display-5 text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <h6 class="mb-1">@Model.Property?.Address</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Property?.City</p>
                            <div class="d-flex gap-3 small text-muted mb-2">
                                <span><i class="bi bi-currency-dollar me-1"></i>@Model.Property?.Price.ToString("C0")</span>
                                <span><i class="bi bi-bed me-1"></i>@Model.Property?.BedRooms beds</span>
                                <span><i class="bi bi-house-door me-1"></i>@Model.Property?.Type</span>
                            </div>
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@Model.PropertyID" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>View Property
                            </a>
                        </div>
                    </div>

                    <!-- Actions -->
                    @if (isMyReview || isAdmin)
                    {
                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Reviews
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Reviews
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .reviewer-avatar-lg {
        width: 70px; height: 70px;
        background: var(--sakany-primary, #e74c3c);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700; font-size: 1.5rem;
    }
    .rating-display { line-height: 1; }
</style>