@model IEnumerable<Sakany.Models.Review>
@{
    ViewData["Title"] = "Reviews";
    var role = Context.Session.GetString("UserRole");
    var userId = Context.Session.GetString("UserID");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#1a1a2e">
                <i class="bi bi-star me-2 text-warning"></i>
                @if (role == "Tenant")
                {
                    <text>My Reviews</text>
                }
                else if (role == "Owner")
                {

                    <text>Reviews on My Properties</text>
                }
                else
                {

                    <text>All Reviews</text>
                }
            </h2>
            <p class="text-muted mb-0">@Model.Count() review(s)</p>
        </div>
        @if (role == "Tenant")
        {
            <a asp-action="Create" class="btn btn-warning px-4">
                <i class="bi bi-star me-2"></i>Write a Review
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-star display-1 text-muted opacity-25"></i>
            <p class="mt-3 text-muted">No reviews yet.</p>
            @if (role == "Tenant")
            {
                <a asp-action="Create" class="btn btn-warning">Write Your First Review</a>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="review-card">
                        <!-- Stars -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= item.Rate ? "bi-star-fill text-warning" : "bi-star text-muted")"
                                       style="font-size:.9rem"></i>
                                }
                            </div>
                            <small class="text-muted">@item.Date.ToString("dd MMM yyyy")</small>
                        </div>

                        <!-- Description -->
                        <p class="review-text">@(string.IsNullOrEmpty(item.Description) ? "No comment." : item.Description)</p>

                        <!-- Property -->
                        <div class="review-meta">
                            <i class="bi bi-buildings me-1 text-danger"></i>
                            <span class="small text-muted">@item.Property?.Address</span>
                        </div>

                        <!-- Reviewer (for owner/admin) -->
                        @if (role != "Tenant")
                        {
                            <div class="review-meta mt-1">
                                <div class="mini-avatar">@(item.Client?.Name?[0].ToString() ?? "?")</div>
                                <span class="small text-muted">@item.Client?.Name</span>
                            </div>
                        }

                        <!-- Actions -->
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Details" asp-route-id="@item.ID"
                               class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            @if (role == "Tenant" && item.ClientID == userId)
                            {
                                <a asp-action="Edit" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-warning flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-outline-danger flex-fill">
                                    <i class="bi bi-trash me-1"></i>
                                </a>
                            }
                            @if (role == "Admin")
                            {
                                <a asp-action="Delete" asp-route-id="@item.ID"
                                   class="btn btn-sm btn-outline-danger flex-fill">
                                    <i class="bi bi-trash me-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .review-card {
        background: #fff;
        border-radius: 14px;
        padding: 1.2rem;
        box-shadow: 0 3px 14px rgba(0,0,0,0.07);
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: .2s;
    }

        .review-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.11);
        }

    .review-text {
        font-size: .88rem;
        color: #444;
        line-height: 1.5;
        flex: 1;
        margin-bottom: .75rem;
    }

    .review-meta {
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .mini-avatar {
        width: 22px;
        height: 22px;
        background: #e74c3c;
        border-radius: 50%;
        color: #fff;
        font-size: .65rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>
