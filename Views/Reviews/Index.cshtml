@model IEnumerable<Sakany.Models.Review>
@{
    ViewData["Title"] = "Reviews";
    var avgRating = ViewBag.AverageRating as double? ?? 0;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-star-fill me-2 text-warning"></i>Reviews</h2>
            <p class="text-muted mb-0">
                @Model.Count() review@(Model.Count() != 1 ? "s" : "") ·
                Average: <span class="text-warning"><strong>@avgRating.ToString("0.0")</strong></span>
                <i class="bi bi-star-fill text-warning small"></i>
            </p>
        </div>
        @if (Context.Session.GetString("UserRole") == "Tenant")
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>Write a Review
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-star display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No reviews yet</h4>
            <p class="text-muted">Be the first to share your experience!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm review-card">
                        <div class="card-body p-4">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="reviewer-avatar">
                                        @(item.Client?.Name?[0].ToString().ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <h6 class="mb-0">@item.Client?.Name</h6>
                                        <small class="text-muted">@item.Date.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                                <div class="rating-badge">
                                    <span class="fw-bold">@item.Rate</span><small>/5</small>
                                </div>
                            </div>

                            <!-- Stars -->
                            <div class="mb-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= item.Rate ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                }
                            </div>

                            <!-- Review Text -->
                            <p class="card-text text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Description) ? "No written feedback provided." : item.Description)
                            </p>

                            <!-- Property Context -->
                            <div class="p-2 bg-light rounded d-flex align-items-center gap-2">
                                <i class="bi bi-house-door text-primary"></i>
                                <small class="text-truncate">@item.Property?.Address, @item.Property?.City</small>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Read More
                                </a>
                                @if (item.ClientID == Context.Session.GetString("UserID") || Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

<style>
    .review-card { transition: transform 0.2s, box-shadow 0.2s; }
    .review-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important; }
    .reviewer-avatar {
        width: 40px; height: 40px;
        background: var(--sakany-primary, #e74c3c);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 700; font-size: 0.9rem;
    }
    .rating-badge {
        background: #fff8e1;
        color: #f39c12;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.9rem;
    }
</style>